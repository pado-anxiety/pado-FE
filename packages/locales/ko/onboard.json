{
  "steps": {
    "step1": {
      "texts": ["최근에 불안한 적이 있었나요?"],
      "button": "탭하여 계속하기"
    },
    "step2": {
      "texts": ["불안이 밀려올 때\n어떻게 하고 계시나요?"],
      "button": "탭하여 계속하기"
    },
    "step3": {
      "texts": ["불안은 없애야 할 대상이 아니라,\n파도처럼 왔다가 사라지는\n자연스러운 감정이에요."],
      "button": "탭하여 계속하기"
    },
    "step4": {
      "texts": ["하지만 그 파도에서도\n균형을 지키는 것이 중요해요."],
      "button": "탭하여 계속하기"
    },
    "step5": {
      "texts": ["파도와 함께\n불안을 관리하고\n다시 나아가는 연습을\n시작해보세요."],
      "button": "시작하기"
    }
