  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    { "mode": "auto" },
    "./apps/expo",
    "./apps/web",
    "./packages/*"
  ],
  "eslint.runtime": "node",
  "biome.enabled": false
}